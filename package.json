{
    "name": "delta-e-ts",
    "version": "1.1.0",
    "description": "Library to calculate DeltaE from any two CIE-Lab colors. Also includes utils to convert hex string to RGB and RGB to CIE-Lab color space",
    "homepage": "https://github.com/d1vij/DeltaE#readme",
    "bugs": {
        "url": "https://github.com/d1vij/DeltaE/issues"
    },
    "license": "GPL-3.0-only",
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/d1vij/DeltaE.git"
    },
    "scripts": {
        "build": "bunup",
        "dev": "bunup --watch",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "prepare": "bun simple-git-hooks",
        "release": "bumpp --commit --push --tag",
        "test": "bun test",
        "test:coverage": "bun test --coverage",
        "test:watch": "bun test --watch",
        "type-check": "tsc --noEmit"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.13",
        "@types/bun": "^1.3.8",
        "bumpp": "^10.4.0",
        "bunup": "^0.16.22",
        "simple-git-hooks": "^2.13.1",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "typescript": ">=4.5.0"
    },
    "peerDependenciesMeta": {
        "typescript": {
            "optional": true
        }
    },
    "type": "module",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "module": "./dist/index.js",
    "simple-git-hooks": {
        "pre-commit": "bun run lint && bun run type-check"
    },
    "types": "./dist/index.d.ts"
}
